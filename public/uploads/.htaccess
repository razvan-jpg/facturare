Options -Indexes
# Doar fișiere statice — fără execuție PHP în uploads.
<FilesMatch "(?i)\.(php|phtml|phar|cgi|pl|py|jsp|asp|aspx|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
