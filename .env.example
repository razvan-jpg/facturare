APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Bucharest
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Pe producție (shared): database — evită lock-uri pe fișiere și request-uri blocate de email.
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=failover
MAIL_HOST=mail.dateconta.ro
MAIL_PORT=465
MAIL_PORT_TLS=587
MAIL_USERNAME=contact.facturare@dateconta.ro
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=60
MAIL_FROM_ADDRESS="contact.facturare@dateconta.ro"
MAIL_FROM_NAME="DateConta Facturare"
MAIL_EHLO_DOMAIN=dateconta.ro
MAIL_DELIVERY_MAILERS=smtp,smtp_tls,sendmail

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ANAF SPV / e-Factura OAuth (înregistrează aplicația pe portalul ANAF Dezvoltatori)
ANAF_ENV=prod
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_CALLBACK_URL="${APP_URL}/anaf/oauth/callback"

# Cron HTTP (opțional pe shared): GET /cron/run?token=...
SCHEDULE_TOKEN=

# Abonament App Store (doar iOS) — vezi ios/.../APP_STORE_CONNECT.md
IOS_SUBSCRIPTION_FREE_UNTIL=2027-03-31
# Compat: produs implicit; lista completă e în config/dateconta.php → product_ids
IOS_SUBSCRIPTION_PRODUCT_ID=ro.dateconta.facturare.premium.monthly
IOS_SUBSCRIPTION_BUNDLE_ID=com.dateconta.Facturare-by-DateConta.Facturare-by-DateConta
# IOS_IAP_ALLOW_UNVERIFIED=true   # doar local — NU în producție


# Cont bancar platformă (plăți OP abonament)
PLATFORM_IBAN=
PLATFORM_BANK_NAME=

# Netopia Payments (card) — cheile din panoul merchant Netopia
NETOPIA_ENABLED=false
NETOPIA_SANDBOX=true
NETOPIA_SIGNATURE=
NETOPIA_PUBLIC_KEY_PATH=
NETOPIA_PRIVATE_KEY_PATH=

# Mollie Payments (card) — https://my.mollie.com/dashboard/developers/api-keys
MOLLIE_ENABLED=false
MOLLIE_KEY=

EUPLATESC_ENABLED=false
EUPLATESC_SANDBOX=true
EUPLATESC_MID=
EUPLATESC_KEY=

# Stripe (abonament platformă) — https://dashboard.stripe.com/apikeys
STRIPE_ENABLED=true
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_RESTRICTED_KEY=
# Opțional: Price ID-uri predefinite (altfel se creează automat)
STRIPE_PRICE_1M=
STRIPE_PRICE_3M=
STRIPE_PRICE_6M=
STRIPE_PRICE_1Y=
